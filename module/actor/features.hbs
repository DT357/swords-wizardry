<section
  class="tab {{tabs.features.id}} {{tabs.features.cssClass}}"
  data-tab="{{tabs.features.id}}"
  data-group="{{tabs.features.group}}"
>
  <section class="grid grid-8col">
    <aside class="sidebar grid-span-3">
      <div class="abilities flexcol">
        <h3>{{ localize 'SWORDS_WIZARDRY.CharacterSheet.Main.AttributeScores' }}</h3>
        {{#each system.abilities as |ability key|}}
        <div class="ability grid grid-6col">
          <button
            type="button"
            class="ability-roll-control grid-span-3"
            data-action="abilityRoll"
            data-ability="{{key}}"
            aria-label="{{localize 'SWORDS_WIZARDRY.Chat.RollNamed' name=ability.label}}"
          >
            <i class="fas fa-dice-d20" aria-hidden="true"></i>
            <span>{{ability.label}}</span>
          </button>
          <input class="checkbox-small" type="checkbox" name="system.abilities.{{key}}.prime" {{checked ability.prime}}/>
          <input class="resource-value grid-span-2" type="text" name="system.abilities.{{key}}.value" value="{{ability.value}}" data-dtype="Number"/>
        </div>
        {{/each}}
        <hr>
        <span class="resource-label"><h3>{{ localize 'SWORDS_WIZARDRY.CharacterSheet.Main.AttributeBonuses' }}</h3></span>
        <div class="modifiers">
          {{#each system.modifiers as |modifier key|}}
          <div class="grid grid-3col">
            <label
              for="system.modifiers.{{modifier}}.value"
              class="modifier-label grid-span-2"
              data-label="{{modifier.label}}"
            >
              {{modifier.label}}
            </label>
            <input class="modifier-value" type="text" name="system.modifiers.{{key}}.value" value="{{modifier.value}}" data-dtype="Number"/>
          </div>
          {{/each}}
        </div>
      </div>
    </aside>
    <section class="main grid-span-5">
      <h3>{{localize 'SWORDS_WIZARDRY.CharacterSheet.Features.Table.Title'}}</h3>
      <ol class='items-list'>
        <li class='item items-header grid grid-4col'>
          <div class='item-name grid-span-3'>
            {{localize 'SWORDS_WIZARDRY.CharacterSheet.Features.Table.Name'}}
          </div>
          <div class='item-controls'>
            <button
              type="button"
              class='item-control'
              data-action="itemCreate"
              data-type='feature'
              aria-label={{
                localize 'SWORDS_WIZARDRY.CharacterSheet.Features.Table.Create'
                type='feature'
              }}
            >
              <i class='fas fa-plus' aria-hidden="true"></i>
            </button>
          </div>
        </li>
        {{#each features as |item id|}}
        <li class='item grid grid-4col' data-item-id='{{item._id}}'>
          <div class='item-name grid-span-3'>
            <div class='item-image'>
              <button
                type="button"
                class='rollable'
                data-action="roll"
                data-id="{{item._id}}"
                data-roll-type='item'
                aria-label="{{localize 'SWORDS_WIZARDRY.Chat.RollNamed' name=item.name}}"
              >
                <img
                  src='{{item.img}}'
                  alt=""
                  width='24'
                  height='24'
                />
              </button>
            </div>
            <span class='item-name-span'>{{item.name}}</span>
          </div>
          <div class='item-controls'>
            <button
              type="button"
              class='item-control'
              data-action="itemEdit"
              data-id="{{item.id}}"
              aria-label='{{
                localize "SWORDS_WIZARDRY.CharacterSheet.Features.Table.Update"
                type='feature'
              }}'
            >
              <i class='fas fa-edit' aria-hidden="true"></i>
            </button>
            <button
              type="button"
              class='item-control'
              data-action="itemDelete"
              data-id="{{item.id}}"
              aria-label='{{
                localize "SWORDS_WIZARDRY.CharacterSheet.Features.Table.Delete"
                type='feature'
              }}'
            >
              <i class='fas fa-trash' aria-hidden="true"></i>
            </button>
          </div>
        </li>
        {{/each}}
      </ol>
    </section>
  </section>
</section>
