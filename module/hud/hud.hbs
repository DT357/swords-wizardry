<div class="combat-hud">
  <p class="combat-hud__status">
    <span>{{localize "SWORDS_WIZARDRY.Stats.ArmorClass.abbr"}}: {{#if useAscendingAC}}{{actor.system.aac.value}}{{else}}{{actor.system.ac.value}}{{/if}}</span>
    <span>{{localize "SWORDS_WIZARDRY.Stats.HitPoints.abbr"}}: {{actor.system.hp.value}}/{{actor.system.hp.max}}</span>
  </p>
  <ul class="combat-hud-list">
    <li>
      <button type="button" data-action="save" aria-label="{{localize 'SWORDS_WIZARDRY.Hud.RollSave'}}">
        <img src="systems/swords-wizardry/assets/game-icons-net/dice-twenty-faces-twenty.svg" alt="" width="24" height="24">
        <span>{{localize "SWORDS_WIZARDRY.Stats.SavingThrow.long"}}</span>
      </button>
    </li>
    {{#each actor.items as |item|}}
      {{#if (eq item.type "weapon")}}
        <li>
          <button type="button" data-action="item" data-item-id="{{item.id}}" aria-label="{{localize 'SWORDS_WIZARDRY.Hud.RollItem' name=item.name}}">
            <img src="{{item.img}}" alt="" width="24" height="24">
            <span>{{item.name}}</span>
          </button>
        </li>
      {{/if}}
    {{/each}}
    {{#each actor.items as |feature|}}
      {{#if (eq feature.type "feature")}}
      {{#if feature.system.formula}}
        <li>
          <button type="button" data-action="item" data-item-id="{{feature.id}}" aria-label="{{localize 'SWORDS_WIZARDRY.Hud.RollItem' name=feature.name}}">
            <img src="{{feature.img}}" alt="" width="24" height="24">
            <span>{{feature.name}}</span>
          </button>
        </li>
      {{/if}}
      {{/if}}
    {{/each}}
    {{#each actor.system.spellSlots as |level|}}
      {{#each level.memorizedSpells as |spell|}}
        <li>
          <button type="button" data-action="cast" data-item-id="{{spell.id}}" aria-label="{{localize 'SWORDS_WIZARDRY.Hud.CastSpell' name=spell.name}}">
            <img src="{{spell.img}}" alt="" width="24" height="24">
            <span>{{spell.name}}</span>
          </button>
        </li>
      {{/each}}
    {{/each}}
  </ul>
</div>
