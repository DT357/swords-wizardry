<section class="importer-form">
  <p>{{localize "SWORDS_WIZARDRY.Importer.ExpectedFormat"}}</p>
  <p><code>{{localize "SWORDS_WIZARDRY.Importer.Example"}}</code></p>
  {{#if errors.length}}
    <ul class="form-errors" role="alert">
      {{#each errors as |error|}}
        <li>{{error.message}}</li>
      {{/each}}
    </ul>
  {{/if}}
  <label for="swords-wizardry-import-text">{{localize "SWORDS_WIZARDRY.Importer.StatBlock"}}</label>
  <textarea id="swords-wizardry-import-text" name="importText" maxlength="20000" required>{{importText}}</textarea>
  <button type="submit" {{#if pending}}disabled{{/if}}>
    {{localize "SWORDS_WIZARDRY.Importer.Submit"}}
  </button>
</section>
